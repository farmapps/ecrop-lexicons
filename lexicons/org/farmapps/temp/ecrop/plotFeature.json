{
  "lexicon": 1,
  "id": "org.farmapps.temp.ecrop.plotFeature",
  "defs": {
    "main": {
      "type": "record",
      "description": "A plotFeature record (OpenAPI schema PlotFeatureTopLevel).",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "geoJsonType",
          "geometry",
          "properties"
        ],
        "properties": {
          "geoJsonType": {
            "type": "string",
            "const": "Feature",
            "description": "(OpenAPI property name: 'type')"
          },
          "featureId": {
            "type": "string",
            "description": "Feature id (a number id is represented as its decimal string). (OpenAPI property name: 'id')"
          },
          "conformsTo": {
            "type": "array",
            "description": "JSON-FG conformance classes implemented by this document. Required when profile=jsonfg is used",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "coordRefSys": {
            "type": "ref",
            "ref": "org.farmapps.temp.ecrop.geo.defs#coordRefSysType"
          },
          "time": {
            "type": "ref",
            "ref": "org.farmapps.temp.ecrop.geo.defs#jsonFgTimeType"
          },
          "place": {
            "type": "union",
            "description": "Geometry (JSON FG) of the plot (Polygon or MultiPolygon) using the CRS described in coordRefSys. Only applicable for profile=jsonfg. Should not be used for WGS84 coordinates (use geometry in stead) Plot geometry types: Polygon or MultiPolygon.",
            "refs": [
              "org.farmapps.temp.ecrop.geo.defs#polygonType",
              "org.farmapps.temp.ecrop.geo.defs#multiPolygonType"
            ],
            "closed": true
          },
          "geometry": {
            "type": "union",
            "description": "Optional WGS84 fallback geometry (plain GeoJSON) for consumers that support GeoJSON but not JSON-FG. Null when not provided. Constrained to the same geometry types as \"place\" in this schema. Since this field is required, it is nullable in case WGS84 is nog relevant Plot geometry types: Polygon or MultiPolygon.",
            "refs": [
              "org.farmapps.temp.ecrop.geo.defs#polygonType",
              "org.farmapps.temp.ecrop.geo.defs#multiPolygonType"
            ],
            "closed": true
          },
          "featureType": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Feature type(s); a single type is a one element array."
          },
          "properties": {
            "type": "ref",
            "ref": "org.farmapps.temp.ecrop.geo.defs#plotFeatureProperties"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "org.farmapps.temp.ecrop.defs#link"
            }
          }
        },
        "nullable": [
          "geometry"
        ]
      }
    }
  }
}
